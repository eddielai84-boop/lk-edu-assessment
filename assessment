      } else {
        headline = `【课业巩固 + 习惯与心态赋能】帮 ${childName} 建立高效学习节奏`;
        narrative = `从测评来看，${childName} 目前在<strong>${weakSubjs}</strong>及日常作业习惯上需要系统化的支持。单靠普通补习往往不够全面，建议首选<strong>【RM ${maxPackagePrice} 全人卓越领航大配套】</strong>：周一至周五由老师督导学校功课与听写清零、打牢五/六科基础，周六加强三语写作，并透过<strong>免费赠送的品格教育（CBP）</strong>提升专注力、抗挫力与责任心！`;
        consultantPitch = `“家长，双职工家庭最辛苦的就是下班还要催功课、盯听写。我们建议给孩子选择【RM${maxPackagePrice} 大配套】：周一到周五功课和补习我们在中心全搞定，周六帮他把最弱的三语写作拉起来，最超值的是配套里【免费送每月 RM100 的品格教育】，帮孩子养成自律和抗挫心态！您可以在右边点击切换 910/940 和 670/700 对比看看。”`;
      }
    } else {
      // Standard Working Parents with A/B/C score and no extra writing/character flags -> Primary 670/700, Secondary 910/940
      planData.primary = fullPackageObj;
      planData.secondary = maxPackageObj;
      document.getElementById('profileTag').textContent = '双职工省心标配';

      headline = `【稳健护航型】双职工家庭最省心的一站式放学成长方案`;
      narrative = `${childName} 目前成绩与状态平稳（${state.examScore}级）。考虑到父母平时工作忙碌，即使孩子成绩理想，我们也建议至少选择<strong>【RM ${baseFullPrice} 全人教育标准全套班】</strong>，由中心全面照料放学营养午餐、督导每日学校功课与听写，并跟进全科补习。若希望进一步加强三语写作并<strong>免费获得 RM100 品格教育（CBP）</strong>，可直接点击下方<strong>【RM ${maxPackagePrice} 领航大配套】</strong>升级！`;
      consultantPitch = `“家长，虽然孩子目前成绩理想，但因为你们平时都要上班，放学后没人严格督促吃饭、做功课和准备听写，孩子很容易松懈。所以我们建议至少拿【RM${baseFullPrice} 标准全套班】。如果您希望孩子更全面，非常推荐点选第二个【RM${maxPackagePrice} 大配套】，多了周六写作班，还直接免费送价值 RM100 的品格教育！”`;
    }

    // Render Primary & Secondary Cards into DOM
    renderPlanCard('primary', planData.primary);
    renderPlanCard('secondary', planData.secondary);

    document.getElementById('reviewHeadline').textContent = headline;
    document.getElementById('reviewNarrative').innerHTML = narrative;

    choosePlan(state.selectedPlanKey);
  }

  function renderPlanCard(slot, data) {
    document.getElementById(slot + 'Tag').textContent = data.tag;
    document.getElementById(slot + 'Title').textContent = data.name;
    document.getElementById(slot + 'PriceBadge').innerHTML = `RM ${data.monthlyFee} <small>${state.gradeLevel === 'pre_std1' && slot === 'secondary' ? '/ 4个月全期' : '/ 月'}</small>`;
    document.getElementById(slot + 'Sub').textContent = data.sub;

    if (slot === 'primary') {
      const banner = document.getElementById('primaryFreeCbp');
      banner.style.display = data.hasFreeCbp ? 'flex' : 'none';
    }

    const ul = document.getElementById(slot + 'Benefits');
    ul.innerHTML = data.benefits.map(b => `<li><span class="check">✔</span><span>${b}</span></li>`).join('');
  }

  function recalculateFeesOnly() {
    const chosen = planData[state.selectedPlanKey];
    const transport = parseInt(document.getElementById('transportFee').value || '0', 10);
    const need1v1 = document.getElementById('custom1v1Check').checked;
    const isPreStd1 = (state.gradeLevel === 'pre_std1');

    // Show/hide optional CBP add-on row if the chosen package does NOT include free CBP
    const addonRow = document.getElementById('addonCbpRow');
    const addonCheck = document.getElementById('addonCbpCheck');
    if (!chosen.hasFreeCbp && !isPreStd1) {
      addonRow.classList.add('visible');
    } else {
      addonRow.classList.remove('visible');
      addonCheck.checked = false;
    }

    const extraCbpFee = (!chosen.hasFreeCbp && addonCheck.checked) ? 60 : 0;
    const regFee = 90;

    document.getElementById('selectedPlanLabel').textContent = `已选：${chosen.name}`;
    document.getElementById('calcCourseFee').textContent = `RM ${chosen.monthlyFee}`;

    const cbpEl = document.getElementById('calcCbpFee');
    if (chosen.hasFreeCbp) {
      cbpEl.textContent = 'RM 0 (大配套免费赠送，省RM100)';
      cbpEl.style.color = '#4ADE80';
    } else if (extraCbpFee > 0) {
      cbpEl.textContent = '+ RM 60 / 月 (全套班特惠加购，原价RM100)';
      cbpEl.style.color = '#FBBF24';
    } else if (isPreStd1) {
      cbpEl.textContent = '包含课堂习惯引导';
      cbpEl.style.color = '#CBD5E1';
    } else {
      cbpEl.textContent = 'RM 0 (未加报 · 全套班加购仅需+RM60/月，大配套免费送)';
      cbpEl.style.color = '#94A3B8';
    }

    const row1v1 = document.getElementById('calc1v1Row');
    row1v1.style.display = need1v1 ? 'flex' : 'none';

    document.getElementById('calcTransportFee').textContent = `RM ${transport}`;

    const monthlyRecurring = chosen.monthlyFee + extraCbpFee + transport;
    const firstMonthTotal = monthlyRecurring + regFee;

    const suffix1v1 = need1v1 ? ' (+1v1/1v3定制费另计)' : '';
    document.getElementById('calcFirstMonth').textContent = `RM ${firstMonthTotal.toLocaleString()}${suffix1v1}`;

    if (isPreStd1 && state.selectedPlanKey === 'secondary') {
      document.getElementById('calcSecondMonth').textContent = `4个月全期已付清 (仅校车 RM${transport}/月)`;
    } else {
      document.getElementById('calcSecondMonth').textContent = `RM ${monthlyRecurring.toLocaleString()} / 月${suffix1v1}`;
    }
  }

  function setVitalBar(prefix, val, isRedAccent = false) {
    document.getElementById(prefix + 'Text').textContent = val + '%';
    const bar = document.getElementById(prefix + 'Bar');
    bar.style.width = val + '%';
    if (isRedAccent) {
      bar.style.background = '#DC2626';
      return;
    }
    if (val >= 75) bar.style.background = '#16A34A';
    else if (val >= 50) bar.style.background = '#F59E0B';
    else bar.style.background = '#DC2626';
  }

  function fallbackCopy(text, cb) {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta);
    if (cb) cb();
  }

  function getSubmissionPayload() {
    const chosen = planData[state.selectedPlanKey];
    const transportSelect = document.getElementById('transportFee');
    const transportText = transportSelect.options[transportSelect.selectedIndex].text;
    const need1v1 = document.getElementById('custom1v1Check').checked;
    const addonCbp = document.getElementById('addonCbpCheck').checked;

    const gradeMap = {
      'std1_3': '低年级 (Std 1-3)',
      'std4_6': '高年级 (Std 4-6)',
      'pre_std1': '6岁升小一 (Pre-Std 1)'
    };
    const workMap = {
      'working_both': '双职工父母',
      'care_no_teach': '家里有人照看但无法教功课'
    };
    const hwMap = {
      'good': '自律主动完成',
      'drag': '容易拖延磨蹭',
      'conflict': '需要大量督导/易起冲突'
    };
    const charMap = {
      'leader': '积极上进/培养领袖力',
      'passive': '专注力待提升/怕难题',
      'fragile': '自信心不足/抗挫力弱'
    };

    return {
      timestamp: new Date().toLocaleString('zh-MY', { timeZone: 'Asia/Kuala_Lumpur' }),
      studentName: document.getElementById('studentName').value.trim() || '未填写',
      parentPhone: document.getElementById('parentPhone').value.trim() || '未填写',
      schoolName: document.getElementById('schoolName').value,
      gradeLevel: gradeMap[state.gradeLevel] || state.gradeLevel,
      parentWork: workMap[state.parentWork] || state.parentWork,
      examScore: state.examScore + ' 级',
      weakSubjects: getSelectedSubjects(),
      writingGoal: state.writingGoal === 'need_boost' ? '希望加强三语写作/自我提升' : '先稳固平日正课与功课',
      homeworkState: hwMap[state.homeworkState] || state.homeworkState,
      characterState: charMap[state.characterState] || state.characterState,
      selectedPlan: chosen.name,
      courseMonthlyFee: 'RM ' + chosen.monthlyFee,
      cbpStatus: chosen.hasFreeCbp ? '大配套免费赠送 (RM 0)' : (addonCbp ? '加购品格教育 (+RM 60/月)' : '未加购 (RM 0)'),
      custom1v1: need1v1 ? '需要预约 1v1/1v3 定制课' : '常规班即可',
      transport: transportText,
      firstMonthTotal: document.getElementById('calcFirstMonth').textContent,
      recurringMonthlyTotal: document.getElementById('calcSecondMonth').textContent
    };
  }

  async function submitToGoogleSheet() {
    const btn = document.getElementById('submitSheetBtn');
    const payload = getSubmissionPayload();

    if (!GOOGLE_SCRIPT_URL || GOOGLE_SCRIPT_URL.includes('PASTE_YOUR')) {
      showToastNotification('⚠️ 请先在 HTML 代码顶部填入您的 GOOGLE_SCRIPT_URL 网址！');
      return;
    }

    const origHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span>⏳</span> 正在加密同步至中心 Google Sheet...';

    try {
      await fetch(GOOGLE_SCRIPT_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(payload)
      });
      btn.innerHTML = '<span>✅</span> 提交成功！资料已存入 Google Sheet';
      showToastNotification('✅ 家长测评资料已成功同步至 Google Sheet！');
      setTimeout(() => {
        btn.disabled = false;
        btn.innerHTML = origHtml;
      }, 3500);
    } catch (err) {
      btn.disabled = false;
      btn.innerHTML = origHtml;
      showToastNotification('❌ 提交失败，请检查网络连接或 Apps Script 网址。');
    }
  }

  function showToastNotification(msg) {
    const toast = document.getElementById('toastMsg');
    toast.textContent = msg;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3200);
  }

  function copyReportForWhatsApp() {
    const nameInput = document.getElementById('studentName').value.trim() || '孩子';
    const parentPhone = document.getElementById('parentPhone').value.trim();
    const school = document.getElementById('schoolName').value;
    const chosen = planData[state.selectedPlanKey];
    const headline = document.getElementById('reviewHeadline').textContent;
    const narrative = document.getElementById('reviewNarrative').innerText;
    const firstMonth = document.getElementById('calcFirstMonth').textContent;
    const secondMonth = document.getElementById('calcSecondMonth').textContent;
    const need1v1 = document.getElementById('custom1v1Check').checked;

    const lines = [
      '❤ *【LK EDU 全人教育 · 孩子学情与课程规划报告】*',
      '*Be The Legend · 全人教育为主 · STREAM为辅 · 心态至上*',
      '━━━━━━━━━━━━━━━━━━',
      '👦 *学生姓名*：' + nameInput + (parentPhone ? ' (' + parentPhone + ')' : ''),
      '🏫 *就读学校*：' + school,
      '💡 *顾问评估小结*：' + headline,
      '',
      '📝 *成长规划建议*：',
      narrative,
      '',
      '🌟 *家长选定课程方案*：*' + chosen.name + '*',
      '💰 *课程月费*：RM ' + chosen.monthlyFee
    ];
    if (chosen.hasFreeCbp) {
      lines.push('🎁 *专属福利*：免费获赠【品格教育 CBP】(原价RM100/月)');
    } else if (document.getElementById('addonCbpCheck').checked) {
      lines.push('❤️ *加报课程*：品格教育课程 CBP (+RM 60/月 全套班专属优惠)');
    }
    if (need1v1) {
      lines.push('🎯 *特别定制*：预约安排【1v1 / 1v3 定制专属课堂】(学费由中心另外规划安排)');
    }
    lines.push('📌 *首月入学预算(含RM90报名费送精装T-Shirt)*：' + firstMonth);
    lines.push('📅 *次月起常规学费*：' + secondMonth);
    lines.push('━━━━━━━━━━━━━━━━━━');
    lines.push('📞 欢迎联系我们锁定名额或预约到院参观！');

    const text = lines.join(String.fromCharCode(10));

    const showToast = () => {
      const toast = document.getElementById('toastMsg');
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3000);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(showToast).catch(() => fallbackCopy(text, showToast));
    } else {
      fallbackCopy(text, showToast);
    }
  }

  // Initial render
  updateAssessment();
</script>
