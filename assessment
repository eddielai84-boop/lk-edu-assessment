<script>
  // ============================================================================
  // 📌 【Google Sheet 链接设置】
  // 请将您在 Google Apps Script 部署后获得的 Web App URL 粘贴在下方引号内：
  // 例如: const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbx.../exec';
  // ============================================================================
  const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzABARF2h-1nUEl33oOmwcOT1kQhdZsxqVGyTE2uvajiFlQ7aJ7EEIdD4PMvfh7obma/exec';

  const state = {
    gradeLevel: 'std1_3',
    parentWork: 'working_both',
    examScore: 'B',
    writingGoal: 'need_boost',
    homeworkState: 'drag',
    characterState: 'passive',
    customClass: 'no',
    selectedPlanKey: 'primary' // 'primary' or 'secondary'
  };

  // Stores computed plan data so clicking Primary vs Secondary updates fees immediately
  let planData = {
    primary: {
      name: '',
      monthlyFee: 910,
      hasFreeCbp: true
    },
    secondary: {
      name: '',
      monthlyFee: 670,
      hasFreeCbp: false
    }
  };

  function selectOption(el) {
    const group = el.getAttribute('data-group');
    const val = el.getAttribute('data-val');
    state[group] = val;

    document.querySelectorAll(`.option-card[data-group="${group}"]`).forEach(card => {
      card.classList.remove('selected');
    });
    el.classList.add('selected');

    // Sync 1v1 checkbox when Q1 is E or Q6 changes
    if (group === 'examScore' && val === 'E') {
      setOptionProgrammatically('customClass', 'yes_1v1');
      document.getElementById('custom1v1Check').checked = true;
    } else if (group === 'customClass') {
      document.getElementById('custom1v1Check').checked = (val === 'yes_1v1');
    }

    // Reset to primary recommended plan whenever questionnaire answers change
    state.selectedPlanKey = 'primary';
    document.getElementById('addonCbpCheck').checked = false;
    updateAssessment();
  }

  function setOptionProgrammatically(group, val) {
    state[group] = val;
    document.querySelectorAll(`.option-card[data-group="${group}"]`).forEach(card => {
      if (card.getAttribute('data-val') === val) {
        card.classList.add('selected');
      } else {
        card.classList.remove('selected');
      }
    });
  }

  function onToggle1v1Checkbox() {
    const checked = document.getElementById('custom1v1Check').checked;
    setOptionProgrammatically('customClass', checked ? 'yes_1v1' : 'no');
    updateAssessment();
  }

  function toggleChip(el) {
    el.classList.toggle('active');
    updateAssessment();
  }

  function getSelectedSubjects() {
    const activeChips = document.querySelectorAll('#weakSubjectsGroup .subject-chip.active');
    const list = Array.from(activeChips).map(c => c.getAttribute('data-subj'));
    return list.length > 0 ? list.join('、') : '全科综合巩固';
  }



  function choosePlan(key) {
    state.selectedPlanKey = key;
    const pCard = document.getElementById('planCardPrimary');
    const sCard = document.getElementById('planCardSecondary');
    const pInd = document.getElementById('primaryIndicator');
    const sInd = document.getElementById('secondaryIndicator');

    if (key === 'primary') {
      pCard.classList.add('active-plan');
      sCard.classList.remove('active-plan');
      pInd.textContent = '✔ 当前已选方案';
      sInd.textContent = '点击切换此方案';
    } else {
      sCard.classList.add('active-plan');
      pCard.classList.remove('active-plan');
      sInd.textContent = '✔ 当前已选方案';
      pInd.textContent = '点击切换此方案';
    }

    recalculateFeesOnly();
  }

  function resetForm() {
    document.getElementById('studentName').value = '';
    document.getElementById('parentPhone').value = '';
    document.getElementById('transportFee').value = '0';
    document.getElementById('custom1v1Check').checked = false;
    document.getElementById('addonCbpCheck').checked = false;
    setOptionProgrammatically('gradeLevel', 'std1_3');
    setOptionProgrammatically('parentWork', 'working_both');
    setOptionProgrammatically('examScore', 'B');
    setOptionProgrammatically('writingGoal', 'need_boost');
    setOptionProgrammatically('homeworkState', 'drag');
    setOptionProgrammatically('characterState', 'passive');
    setOptionProgrammatically('customClass', 'no');
    state.selectedPlanKey = 'primary';
    updateAssessment();
  }

  function updateAssessment() {
    const nameInput = document.getElementById('studentName').value.trim();
    const childName = nameInput ? nameInput : '您的孩子';
    const weakSubjs = getSelectedSubjects();

    const isHighGrade = state.gradeLevel === 'std4_6';
    const isPreStd1 = state.gradeLevel === 'pre_std1';
    const baseFullPrice = isHighGrade ? 700 : 670;
    const maxPackagePrice = isHighGrade ? 940 : 910;
    const gradeLabel = isPreStd1 ? '升小一 (Pre-Primary 1)' : (isHighGrade ? 'Std 4 - 6 高年级' : 'Std 1 - 3 低年级');

    // Update 4D Growth Indicators
    let acadScore = 76, hwScore = 55, charScore = 65, careScore = 98;
    if (state.examScore === 'A') acadScore = 92;
    else if (state.examScore === 'B') acadScore = 78;
    else if (state.examScore === 'C') acadScore = 60;
    else if (state.examScore === 'D') acadScore = 42;
    else if (state.examScore === 'E') acadScore = 28;

    if (state.homeworkState === 'good') hwScore = 88;
    else if (state.homeworkState === 'drag') hwScore = 55;
    else if (state.homeworkState === 'conflict') hwScore = 35;

    if (state.characterState === 'leader') charScore = 90;
    else if (state.characterState === 'passive') charScore = 62;
    else if (state.characterState === 'fragile') charScore = 40;

    if (state.parentWork === 'working_both') careScore = 98;
    else careScore = 85;

    setVitalBar('vitalAcademic', acadScore);
    setVitalBar('vitalHomework', hwScore);
    setVitalBar('vitalCharacter', charScore);
    setVitalBar('vitalCare', careScore, true);

    // Sync 1v1 visual state
    const need1v1 = (state.customClass === 'yes_1v1' || state.examScore === 'E');
    const c1v1Check = document.getElementById('custom1v1Check');
    const c1v1Banner = document.getElementById('custom1v1Banner');
    c1v1Check.checked = need1v1;
    if (need1v1) c1v1Banner.classList.add('checked');
    else c1v1Banner.classList.remove('checked');

    // Determine whether 910/940 or 670/700 is the Primary Recommendation
    const recommendMaxFirst = (
      state.examScore === 'D' ||
      state.examScore === 'E' ||
      state.writingGoal === 'need_boost' ||
      state.characterState === 'fragile' ||
      state.characterState === 'leader' ||
      state.homeworkState === 'conflict'
    );

    let headline = '';
    let narrative = '';
    let consultantPitch = '';

    const fullPackageObj = {
      tag: recommendMaxFirst ? '🌱 基础备选方案（双职工标准配套）' : '👑 顾问首选推荐方案（双职工省心标配）',
      name: `[${gradeLabel}] 全人教育标准全套班`,
      monthlyFee: baseFullPrice,
      hasFreeCbp: false,
      sub: '全科补习 + 每日功课辅导班 + 安亲托管班 (包营养午餐与活动)',
      benefits: [
        '【安心生活托管】：放学营养午餐、冲凉更衣与规律作息照料，父母安心上班',
        '【功课与听写100%督导】：老师逐题检查每日学校功课与隔日听写，回家不再为作业起冲突',
        `【全科系统补习】：涵盖${isHighGrade ? '华、国、英、数、科、历史 6科' : '华、国、英、数、科 5科'}同步强化`
      ]
    };

    const maxPackageObj = {
      tag: recommendMaxFirst ? '👑 顾问首选推荐方案（全方位提升/强化）' : '🚀 进阶升级方案（+周六写作班 +免费送品格课）',
      name: `[${gradeLabel}] 全人卓越领航大配套`,
      monthlyFee: maxPackagePrice,
      hasFreeCbp: true,
      sub: '全科补习 + 功课辅导班 + 安亲托管(含午餐) + 星期六创♥三语写作班 + 免费品格教育(CBP)',
      benefits: [
        '【包含全套班所有服务】：周一至周五营养午餐、冲凉、学校功课与听写100%完成 + 全科补习',
        `【星期六创♥三语写作班】：针对 ${weakSubjs} 强化造句、词汇积累与长篇作文结构`,
        '【🎁 免费赠送品格教育 CBP】：原价 RM100/月，在大配套中免费享有，培养自律、抗挫力与自信心态'
      ]
    };

    if (isPreStd1) {
      document.getElementById('profileTag').textContent = '幼小衔接成长规划';
      headline = `【幼小衔接预备期】帮助 ${childName} 自信迈入华小一年级`;
      narrative = `6岁升入小学一年级是建立学习习惯的黄金期。建议先透过<strong>升小一预备课程</strong>打好<strong>${weakSubjs}</strong>基础；待正式升入一年级后，由于父母忙于工作，可直接衔接全套安亲补习班，一站式搞定午餐、功课与全科学习。`;

      planData.primary = {
        tag: '👑 幼小衔接首选方案（月付灵活用）',
        name: '升小一预备衔接课程 (按月缴费)',
        monthlyFee: 168,
        hasFreeCbp: false,
        sub: '提前掌握华小三语拼读、基础数学运算与小学课堂规律',
        benefits: [
          '提前熟悉华小一年级国文(BM)音节、英文拼读与华文认字写字',
          '建立正确的握笔书写姿势、课堂专注力与听指令习惯',
          '一年级开学后可无缝升入 RM670 全套班或 RM910 领航大配套'
        ]
      };

      planData.secondary = {
        tag: '💎 4个月全期优惠方案（立省 RM34）',
        name: '升小一预备衔接课程 (4个月全期配套)',
        monthlyFee: 638,
        hasFreeCbp: false,
        sub: '一次性缴清 4 个月完整幼小衔接课程，享优惠价 RM638',
        benefits: [
          '完整覆盖 4 个月升小一三语与数学核心衔接大纲',
          '相比按月缴费（RM168×4=RM672）直接节省 RM34',
          '帮助孩子在开学前建立充足的学业自信心'
        ]
      };

      consultantPitch = `“家长您好，孩子即将升入一年级，提前适应三语拼读和听写非常关键。您可以直接点选右侧的【月付 RM168】或【4个月全期优惠 RM638】方案；等明年正式上一年级时，因为你们夫妻俩都有工作，我们再直接帮孩子转入 RM670 全套班或 RM910 大配套，放学后一切交给我们！”`;

    } else if (recommendMaxFirst) {
      planData.primary = maxPackageObj;
      planData.secondary = fullPackageObj;

      const isTopStudent = (state.examScore === 'A' || state.examScore === 'B') && state.homeworkState !== 'conflict';
      document.getElementById('profileTag').textContent = isTopStudent ? '优等拔尖 · 全面领航' : '基础强化 · 习惯养成';

      if (need1v1) {
        headline = `【全套安心督导 + 个别化重点突破】助 ${childName} 稳步追赶、重拾信心`;
        narrative = `评估显示，${childName} 目前在<strong>${weakSubjs}</strong>上需要老师更高关注度的引导。我们建议平时采用<strong>【RM ${maxPackagePrice} 全人卓越领航大配套】</strong>把日常学校功课、三语写作与自信心态（免费含品格教育 CBP）全面照顾好；同时搭配<strong>【1v1 或 1v3 定制课堂】</strong>针对弱项点对点辅导，效果更显著！`;
        consultantPitch = `“家长，孩子目前在【${weakSubjs}】比较吃力，最理想的方式是平时放在我们 RM${maxPackagePrice} 大配套里，先把放学午餐、学校功课、周六写作和品格心态全部稳住；同时针对最弱的科目，我们帮他额外安排【1v1 或 1v3 定制课堂】，老师手把手帮他把基础补起来，学费我们按课时另外为您规划！”`;
      } else if (isTopStudent) {
        headline = `【优秀更卓越 · 自我提升型】为 ${childName} 注入高阶写作力与领袖品格`;
        narrative = `${childName} 目前学业表现优异（${state.examScore}级）！由于爸妈平时工作繁忙，放学后的高效陪伴尤为重要。强烈推荐首选<strong>【RM ${maxPackagePrice} 全人卓越领航大配套】</strong>：除包办周一至周五午餐、功课与全科补习外，更包含<strong>星期六创♥三语写作班</strong>突破高分写作，并<strong>免费赠送价值 RM100/月 的品格教育（CBP）</strong>，培养孩子的演说自信与领导格局！（您也可点击下方 RM${baseFullPrice} 标准全套班对比学费）`;
