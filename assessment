<!DOCTYPE html>
<html lang="zh-MY">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LK EDU 全人教育 · 孩子学情与成长潜能测评系统</title>
<style>
  :root {
    --bg-main: #FFFDF7;
    --bg-card: #FFFFFF;
    --lk-red-700: #B91C1C;
    --lk-red-600: #DC2626;
    --lk-red-500: #EF4444;
    --lk-red-100: #FEE2E2;
    --lk-red-50: #FEF2F2;
    --lk-gold-700: #B45309;
    --lk-gold-600: #D97706;
    --lk-gold-500: #F59E0B;
    --lk-gold-400: #FBBF24;
    --lk-gold-200: #FDE68A;
    --lk-gold-100: #FEF3C7;
    --lk-gold-50: #FFFBEB;
    --stream-blue-700: #0369A1;
    --stream-blue-600: #0284C7;
    --stream-blue-100: #E0F2FE;
    --stream-blue-50: #F0F9FF;
    --mindset-green-700: #15803D;
    --mindset-green-600: #16A34A;
    --mindset-green-100: #DCFCE7;
    --mindset-green-50: #F0FDF4;
    --navy-900: #1E293B;
    --navy-800: #334155;
    --navy-700: #475569;
    --slate-500: #64748B;
    --slate-400: #94A3B8;
    --slate-200: #E2E8F0;
    --slate-100: #F1F5F9;
    --radius-xl: 22px;
    --radius-lg: 16px;
    --radius-md: 12px;
    --shadow-soft: 0 12px 32px -8px rgba(185, 28, 28, 0.06), 0 4px 14px -2px rgba(15, 23, 42, 0.05);
    --shadow-active: 0 16px 36px -8px rgba(220, 38, 38, 0.18);
    --transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Segoe UI", Roboto, sans-serif;
    background: radial-gradient(circle at top right, #FEF3C7 0%, #FFFDF7 40%, #F0F9FF 100%);
    color: var(--navy-900);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    padding-bottom: 64px;
  }

  /* Top Brand Showcase Header */
  .brand-hero {
    background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 45%, #E0F2FE 100%);
    border-bottom: 4px solid var(--lk-red-600);
    padding: 20px 20px 36px;
    position: relative;
    overflow: hidden;
  }

  .brand-hero-inner {
    max-width: 1240px;
    margin: 0 auto;
  }

  .top-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 18px;
  }

  /* Recreated Crisp SVG LK EDU Logo Pill */
  .lk-logo-badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #FFFFFF;
    padding: 8px 16px;
    border-radius: 14px;
    box-shadow: 0 6px 18px rgba(220, 38, 38, 0.12);
    border: 2px solid var(--lk-red-600);
  }

  .lk-logo-text {
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 0.5px;
    color: #FFFFFF;
    -webkit-text-stroke: 1.8px var(--lk-red-600);
    text-shadow: 0 2px 4px rgba(220, 38, 38, 0.15);
    display: flex;
    align-items: center;
    gap: 3px;
    line-height: 1;
  }

  .lk-logo-heart {
    color: var(--lk-red-600);
    -webkit-text-stroke: 0;
    font-size: 20px;
    display: inline-block;
    transform: translateY(-1px);
  }

  .lk-tagline-pill {
    background: var(--lk-red-600);
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 6px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
  }

  .branch-tag {
    font-size: 13px;
    font-weight: 800;
    color: var(--navy-900);
    letter-spacing: 0.5px;
  }

  .header-actions {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-pill {
    background: #FFFFFF;
    border: 1.5px solid var(--slate-200);
    color: var(--navy-900);
    padding: 8px 15px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.04);
  }

  .btn-pill:hover {
    border-color: var(--lk-red-600);
    color: var(--lk-red-600);
    transform: translateY(-1px);
  }

  .btn-pill.active {
    background: var(--lk-red-600);
    border-color: var(--lk-red-600);
    color: #FFFFFF;
  }

  /* Official Banner Showcase Card */
  .hero-banner-card {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 24px;
    align-items: center;
    background: #FFFFFF;
    border-radius: var(--radius-xl);
    padding: 20px 24px;
    box-shadow: 0 16px 40px -10px rgba(220, 38, 38, 0.12);
    border: 2px solid #FDE68A;
  }

  @media (max-width: 900px) {
    .hero-banner-card {
      grid-template-columns: 1fr;
    }
  }

  .banner-img-wrap {
    width: 100%;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--lk-gold-200);
    box-shadow: 0 6px 20px rgba(0,0,0,0.06);
  }

  .banner-img-wrap img {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .philosophy-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .phil-badge {
    font-size: 12.5px;
    font-weight: 800;
    padding: 5px 12px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .phil-red {
    background: var(--lk-red-50);
    color: var(--lk-red-600);
    border: 1px solid var(--lk-red-100);
  }

  .phil-blue {
    background: var(--stream-blue-50);
    color: var(--stream-blue-600);
    border: 1px solid var(--stream-blue-100);
  }

  .phil-green {
    background: var(--mindset-green-50);
    color: var(--mindset-green-600);
    border: 1px solid var(--mindset-green-100);
  }

  .hero-main-title {
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 900;
    color: var(--navy-900);
    line-height: 1.3;
  }

  .hero-main-title span {
    color: var(--lk-red-600);
  }

  .hero-desc {
    font-size: 14px;
    color: var(--navy-700);
  }

  .school-strip {
    background: var(--stream-blue-50);
    border-left: 4px solid var(--stream-blue-600);
    padding: 8px 12px;
    border-radius: 0 8px 8px 0;
    font-size: 12.5px;
    color: var(--stream-blue-700);
    font-weight: 600;
  }

  /* Main Two-Column Layout */
  .main-container {
    max-width: 1240px;
    margin: -18px auto 0;
    padding: 0 20px;
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: 26px;
    align-items: start;
  }

  @media (max-width: 980px) {
    .main-container {
      grid-template-columns: 1fr;
    }
  }

  /* Left Column: Questionnaire Cards */
  .form-column {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .section-card {
    background: var(--bg-card);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-soft);
    border: 1.5px solid var(--slate-200);
    padding: 26px;
    position: relative;
    overflow: hidden;
  }

  .section-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 6px;
    height: 100%;
    background: var(--lk-red-600);
  }

  .section-card.gold-theme::before {
    background: var(--lk-gold-500);
  }

  .section-card.blue-theme::before {
    background: var(--stream-blue-600);
  }

  .section-card.green-theme::before {
    background: var(--mindset-green-600);
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1.5px dashed var(--slate-200);
  }

  .step-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 15px;
    background: var(--lk-red-50);
    color: var(--lk-red-600);
    border: 1px solid var(--lk-red-100);
    flex-shrink: 0;
  }

  .gold-theme .step-icon {
    background: var(--lk-gold-50);
    color: var(--lk-gold-700);
    border-color: var(--lk-gold-200);
  }

  .blue-theme .step-icon {
    background: var(--stream-blue-50);
    color: var(--stream-blue-700);
    border-color: var(--stream-blue-100);
  }

  .green-theme .step-icon {
    background: var(--mindset-green-50);
    color: var(--mindset-green-700);
    border-color: var(--mindset-green-100);
  }

  .section-title-group h2 {
    font-size: 18px;
    font-weight: 800;
    color: var(--navy-900);
  }

  .section-title-group p {
    font-size: 12.5px;
    color: var(--slate-500);
  }

  /* Inputs */
  .input-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 16px;
  }

  @media (max-width: 600px) {
    .input-grid {
      grid-template-columns: 1fr;
    }
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--navy-800);
  }

  .text-input, .select-input {
    width: 100%;
    padding: 11px 14px;
    border: 1.5px solid var(--slate-200);
    border-radius: var(--radius-md);
    font-size: 14px;
    color: var(--navy-900);
    background: #F8FAFC;
    transition: var(--transition);
    outline: none;
    font-weight: 500;
  }

  .text-input:focus, .select-input:focus {
    border-color: var(--lk-red-600);
    background: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1);
  }

  /* Questions */
  .q-block {
    margin-top: 18px;
  }

  .q-block:first-of-type {
    margin-top: 0;
  }

  .q-title {
    font-size: 14.5px;
    font-weight: 800;
    color: var(--navy-900);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .q-badge {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--lk-gold-100);
    color: var(--lk-gold-700);
    font-weight: 700;
  }

  .option-list {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .option-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  @media (max-width: 600px) {
    .option-grid-2 {
      grid-template-columns: 1fr;
    }
  }

  .option-card {
    border: 1.5px solid var(--slate-200);
    border-radius: var(--radius-md);
    padding: 12px 15px;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: #FFFFFF;
    user-select: none;
  }

  .option-card:hover {
    border-color: var(--lk-gold-500);
    background: #FFFDF9;
  }

  .option-card.selected {
    border-color: var(--lk-red-600);
    background: var(--lk-red-50);
    box-shadow: 0 4px 12px rgba(220, 38, 38, 0.08);
  }

  .option-card.selected.gold-select {
    border-color: var(--lk-gold-600);
    background: var(--lk-gold-50);
  }

  .option-card.selected.blue-select {
    border-color: var(--stream-blue-600);
    background: var(--stream-blue-50);
  }

  .radio-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--slate-400);
    margin-top: 2px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
  }

  .option-card.selected .radio-dot {
    border-color: var(--lk-red-600);
    background: var(--lk-red-600);
  }

  .option-card.selected.gold-select .radio-dot {
    border-color: var(--lk-gold-600);
    background: var(--lk-gold-600);
  }

  .option-card.selected.blue-select .radio-dot {
    border-color: var(--stream-blue-600);
    background: var(--stream-blue-600);
  }

  .radio-dot::after {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #FFFFFF;
    opacity: 0;
    transition: var(--transition);
  }

  .option-card.selected .radio-dot::after {
    opacity: 1;
  }

  .option-content {
    flex: 1;
  }

  .option-main {
    font-size: 14px;
    font-weight: 700;
    color: var(--navy-900);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .option-desc {
    font-size: 12.5px;
    color: var(--slate-500);
    margin-top: 2px;
  }

  /* Subject Chips */
  .chip-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .subject-chip {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1.5px solid var(--slate-200);
    background: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    color: var(--navy-700);
    cursor: pointer;
    transition: var(--transition);
    user-select: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .subject-chip:hover {
    border-color: var(--lk-red-500);
  }

  .subject-chip.active {
    background: var(--lk-red-600);
    border-color: var(--lk-red-600);
    color: #FFFFFF;
    box-shadow: 0 3px 10px rgba(220, 38, 38, 0.22);
  }

  /* Right Column: Sticky Assessment & Interactive Course Selector */
  .report-column {
    position: sticky;
    top: 18px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .assessment-panel {
    background: var(--bg-card);
    border-radius: var(--radius-xl);
    box-shadow: 0 20px 45px -12px rgba(185, 28, 28, 0.14);
    border: 2px solid var(--lk-red-600);
    overflow: hidden;
  }

  .panel-top-bar {
    background: linear-gradient(135deg, #B91C1C 0%, #DC2626 60%, #EA580C 100%);
    color: #FFFFFF;
    padding: 18px 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .panel-title-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .panel-top-bar h3 {
    font-size: 16.5px;
    font-weight: 800;
    letter-spacing: 0.3px;
  }

  .status-pill {
    font-size: 11.5px;
    font-weight: 800;
    padding: 4px 11px;
    border-radius: 999px;
    background: #FEF3C7;
    color: #B91C1C;
  }

  .panel-body {
    padding: 20px 22px;
  }

  /* 4D Growth Indicators */
  .vitals-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 18px;
    background: #FFFDF9;
    padding: 14px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--lk-gold-200);
  }

  .vital-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .vital-label {
    font-size: 12px;
    color: var(--navy-800);
    font-weight: 700;
    display: flex;
    justify-content: space-between;
  }

  .vital-bar-bg {
    height: 7px;
    background: var(--slate-200);
    border-radius: 999px;
    overflow: hidden;
  }

  .vital-bar-fill {
    height: 100%;
    border-radius: 999px;
    transition: width 0.4s ease, background 0.3s ease;
  }

  /* Consultant Review Box */
  .review-note-box {
    background: var(--lk-gold-50);
    border: 1.5px solid var(--lk-gold-200);
    border-radius: var(--radius-lg);
    padding: 15px 16px;
    margin-bottom: 18px;
  }

  .review-note-header {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
    font-weight: 800;
    color: var(--lk-red-700);
    margin-bottom: 6px;
  }

  .review-note-text {
    font-size: 13px;
    color: var(--navy-800);
    line-height: 1.6;
  }

  /* Section prompt for clickable plans */
  .selector-prompt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12.5px;
    font-weight: 800;
    color: var(--navy-800);
    margin-bottom: 10px;
  }

  .selector-hint {
    color: var(--lk-red-600);
    font-size: 11.5px;
    background: var(--lk-red-50);
    padding: 2px 8px;
    border-radius: 999px;
  }

  /* Selectable Plan Cards (Primary & Alternative) */
  .plan-selectable-card {
    border-radius: var(--radius-lg);
    border: 2px solid var(--slate-200);
    background: #FFFFFF;
    padding: 16px 18px;
    margin-bottom: 12px;
    cursor: pointer;
    transition: var(--transition);
    position: relative;
    user-select: none;
  }

  .plan-selectable-card:hover {
    border-color: var(--lk-gold-500);
    transform: translateY(-1px);
  }

  .plan-selectable-card.active-plan {
    border: 2.5px solid var(--lk-red-600);
    background: linear-gradient(180deg, #FFF5F5 0%, #FFFFFF 45%);
    box-shadow: var(--shadow-active);
  }

  .plan-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .plan-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 800;
    padding: 3px 9px;
    border-radius: 6px;
    background: var(--lk-gold-100);
    color: var(--lk-gold-700);
  }

  .plan-selectable-card.active-plan .plan-tag {
    background: var(--lk-red-600);
    color: #FFFFFF;
  }

  .select-indicator {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 800;
    color: var(--slate-500);
    padding: 3px 10px;
    border-radius: 999px;
    border: 1.5px solid var(--slate-200);
    background: #F8FAFC;
    transition: var(--transition);
  }

  .plan-selectable-card.active-plan .select-indicator {
    background: var(--mindset-green-600);
    border-color: var(--mindset-green-600);
    color: #FFFFFF;
  }

  .plan-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 4px;
  }

  .plan-name {
    font-size: 16.5px;
    font-weight: 900;
    color: var(--navy-900);
  }

  .plan-price-badge {
    font-size: 20px;
    font-weight: 900;
    color: var(--lk-red-600);
  }

  .plan-price-badge small {
    font-size: 12px;
    font-weight: 600;
    color: var(--slate-500);
  }

  .plan-sub {
    font-size: 12px;
    color: var(--slate-500);
    font-weight: 600;
    margin-bottom: 10px;
  }

  .free-cbp-banner {
    background: linear-gradient(90deg, #FEF3C7 0%, #FDE68A 100%);
    border: 1px solid #F59E0B;
    color: #92400E;
    padding: 7px 11px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 800;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .plan-benefits {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .plan-benefits li {
    font-size: 12.5px;
    color: var(--navy-800);
    display: flex;
    align-items: flex-start;
    gap: 7px;
  }

  .plan-benefits li span.check {
    color: var(--mindset-green-600);
    font-weight: 900;
    flex-shrink: 0;
  }

  /* Optional 1v1 / 1v3 Addon Banner */
  .custom-1v1-banner {
    border: 1.5px dashed var(--stream-blue-600);
    background: var(--stream-blue-50);
    border-radius: var(--radius-md);
    padding: 12px 14px;
    margin-bottom: 14px;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
    user-select: none;
    transition: var(--transition);
  }

  .custom-1v1-banner.checked {
    background: #E0F2FE;
    border-style: solid;
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.12);
  }

  .custom-1v1-banner input {
    margin-top: 4px;
    width: 16px;
    height: 16px;
